{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openjev:jev-http:v1",
  "$comment": "Supported Jev wire subset for POST /v1/systemone. Runtime additionally rejects duplicate keys, floats, nesting over 128 containers, bodies over 1 MiB, and Python-serialized state bytes multiplied by question count over 4 MiB. Runtime enforces conditional --require-shared eligibility.",
  "$defs": {
    "Entry": {
      "anyOf": [
        {"type": "string"},
        {"type": "object"},
        {"type": "array"},
        {"type": "null"}
      ]
    },
    "NoulQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "noul"},
        "instructions": {"$ref": "#/$defs/Entry"},
        "criteria": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "true": {"$ref": "#/$defs/Entry"},
                "false": {"$ref": "#/$defs/Entry"}
              }
            }
          ]
        }
      }
    },
    "ChoiceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "criteria"],
      "properties": {
        "type": {"const": "choice"},
        "instructions": {"$ref": "#/$defs/Entry"},
        "criteria": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {"$ref": "#/$defs/Entry"}
        }
      }
    },
    "ScoreQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "criteria"],
      "properties": {
        "type": {"const": "score"},
        "instructions": {"$ref": "#/$defs/Entry"},
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/Entry"}
        }
      }
    },
    "Question": {
      "oneOf": [
        {"$ref": "#/$defs/NoulQuestion"},
        {"$ref": "#/$defs/ChoiceQuestion"},
        {"$ref": "#/$defs/ScoreQuestion"}
      ]
    },
    "ProbabilityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "ChoiceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "choice", "confidence", "probabilities"],
      "properties": {
        "type": {"const": "choice"},
        "choice": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "probabilities": {"$ref": "#/$defs/ProbabilityMap"}
      }
    },
    "NoulAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "noul"],
      "properties": {
        "type": {"const": "noul"},
        "noul": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ScoreAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "score", "confidence", "legend", "probabilities"],
      "properties": {
        "type": {"const": "score"},
        "score": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "legend": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 16,
          "additionalProperties": {"$ref": "#/$defs/Entry"}
        },
        "probabilities": {"$ref": "#/$defs/ProbabilityMap"}
      }
    },
    "Answer": {
      "oneOf": [
        {"$ref": "#/$defs/ChoiceAnswer"},
        {"$ref": "#/$defs/NoulAnswer"},
        {"$ref": "#/$defs/ScoreAnswer"}
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "questions"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/Entry"},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {"$ref": "#/$defs/Question"}
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"const": 0}
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "answers", "usage"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "answers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {"$ref": "#/$defs/Answer"}
        },
        "usage": {"$ref": "#/$defs/Usage"}
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_type", "message"],
      "properties": {
        "error_type": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/Request"},
    {"$ref": "#/$defs/Response"},
    {"$ref": "#/$defs/Error"}
  ]
}
